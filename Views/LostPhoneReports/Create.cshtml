@model MobileTracker.Models.LostPhoneReport

@{
    ViewData["Title"] = "Report Lost Phone";
}

<style>
    .report-page {
        padding: 40px 0 60px;
        background: #f8f9fa;
        min-height: 80vh;
    }

    .report-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.04);
        padding: 40px 44px;
        max-width: 720px;
        margin: 0 auto;
    }

    .report-header {
        text-align: center;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid #e9ecef;
    }

        .report-header .icon {
            font-size: 40px;
            display: block;
            margin-bottom: 8px;
        }

        .report-header h3 {
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
            font-size: 1.6rem;
        }

        .report-header p {
            color: #6c757d;
            font-size: 0.95rem;
            margin: 4px 0 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #1a1a2e;
            font-size: 0.9rem;
            margin-bottom: 6px;
            display: block;
        }

        .form-group .form-control {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.95rem;
            color: #1a1a2e;
            background: #f8f9fa;
            transition: 0.2s;
            width: 100%;
        }

            .form-group .form-control:focus {
                border-color: #1a1a2e;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(26, 26, 46, 0.06);
                outline: none;
            }

            .form-group .form-control::placeholder {
                color: #adb5bd;
            }

        .form-group .text-danger {
            font-size: 0.85rem;
            margin-top: 4px;
            display: block;
            color: #dc3545;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .btn-submit {
        background: #1a1a2e;
        color: white;
        border: none;
        padding: 14px 32px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        transition: 0.2s;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .btn-submit:hover {
            background: #2d2d44;
            transform: translateY(-2px);
        }

        .btn-submit i {
            font-size: 1.1rem;
        }

    .report-footer {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
    }

        .report-footer small {
            color: #6c757d;
            font-size: 0.85rem;
        }

    .validation-summary {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
        margin-bottom: 20px;
        border: 1px solid #f5c6cb;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .optional-badge {
        color: #6c757d;
        font-weight: 400;
        font-size: 0.8rem;
        margin-left: 6px;
    }

    @@media (max-width: 768px) {
        .report-card {
            padding: 28px 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .report-header h3 {
            font-size: 1.3rem;
        }

        .btn-submit {
            padding: 12px 20px;
            font-size: 0.95rem;
        }
    }

    @@media (max-width: 576px) {
        .report-card {
            padding: 20px 16px;
            border-radius: 16px;
        }

        .form-group .form-control {
            padding: 10px 14px;
            font-size: 0.9rem;
        }
    }
</style>

<div class="report-page">
    <div class="container">

        <div class="report-card">

            <div class="report-header">
                <h3>Report Lost Phone</h3>
                <p>Enter the details of your lost device carefully.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <form asp-action="Create" method="post">

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Brand">Phone Brand</label>
                        <input asp-for="Brand" class="form-control" placeholder="e.g. Samsung" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Model">Phone Model</label>
                        <input asp-for="Model" class="form-control" placeholder="e.g. Galaxy S24" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Color">Color</label>
                        <input asp-for="Color" class="form-control" placeholder="e.g. Black" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="IMEI">IMEI Number</label>
                        <input asp-for="IMEI" class="form-control" placeholder="Enter 15-digit IMEI" />
                        <span asp-validation-for="IMEI" class="text-danger"></span>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="DateOfLoss">Date of Loss</label>
                        <input asp-for="DateOfLoss" type="date" class="form-control" />
                        <span asp-validation-for="DateOfLoss" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LocationLost">Location Lost</label>
                        <input asp-for="LocationLost" class="form-control" placeholder="e.g. GEC Circle" />
                        <span asp-validation-for="LocationLost" class="text-danger"></span>
                    </div>

                </div>

                <div class="form-group">
                    <label asp-for="RewardAmount">
                        Reward Amount
                        <span class="optional-badge">(Optional)</span>
                    </label>
                    <input asp-for="RewardAmount" type="number" class="form-control" placeholder="e.g. 5000" />
                    <span asp-validation-for="RewardAmount" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-plus-circle"></i> Submit Report
                </button>

            </form>

            <div class="report-footer">
                <small>
                    <i class="bi bi-shield-check me-1"></i>
                    Your information will be securely stored in the system.
                </small>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}