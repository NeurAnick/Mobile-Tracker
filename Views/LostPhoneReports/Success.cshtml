@{
    ViewData["Title"] = "Report Submitted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4 text-center">
                <div class="card-body p-5">

                    <div class="mb-4">
                        <div class="display-1"> </div>
                    </div>

                    <h2 class="fw-bold text-success">
                        Report Submitted Successfully!
                    </h2>

                    <p class="text-muted mt-3">
                        Your lost phone report has been successfully
                        submitted to the Mobile Tracker system.
                    </p>

                    <div class="bg-light rounded-4 p-4 my-4">
                        <p class="text-muted mb-1">
                            Your Case ID
                        </p>

                        <h1 class="fw-bold text-primary">
                            #@ViewBag.CaseId
                        </h1>

                        <small class="text-muted">
                            Please keep this Case ID for future tracking.
                        </small>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="LostPhoneReports"
                           asp-action="Create"
                           class="btn btn-primary btn-lg rounded-3">
                            Report Another Phone
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary rounded-3">
                            Back to Home
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>