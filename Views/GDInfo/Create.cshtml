@model List<MobileTracker.Models.Thana>

@{
    ViewData["Title"] = "Add GD Information";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="mb-4">Add GD Information</h2>

                    <p class="text-muted">
                        Case ID: <strong>#@ViewBag.CaseId</strong>
                    </p>

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               name="caseId"
                               value="@ViewBag.CaseId" />

                        <div class="mb-3">

                            <label class="form-label">
                                GD Number
                            </label>

                            <input type="text"
                                   name="gdNumber"
                                   class="form-control"
                                   placeholder="Enter GD Number" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Thana
                            </label>

                            <select name="thanaId"
                                    class="form-select">

                                <option value="0">
                                    -- Select Thana --
                                </option>

                                @foreach (var thana in Model)
                                {
                                    <option value="@thana.ThanaId">
                                        @thana.ThanaName - @thana.District
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                GD Photo
                            </label>

                            <input type="file"
                                   name="gdPhoto"
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">
                                Upload a photo of the GD document.
                            </small>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save GD Information
                            </button>

                            <a asp-controller="LostPhoneReports"
                               asp-action="Details"
                               asp-route-id="@ViewBag.CaseId"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>