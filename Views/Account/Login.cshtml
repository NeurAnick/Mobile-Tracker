@model MobileTracker.Models.User

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        padding: 60px 0 80px;
        background: #f8f9fa;
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .login-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.04);
        padding: 40px 36px;
        max-width: 420px;
        margin: 0 auto;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .login-header .icon {
            font-size: 40px;
            display: block;
            margin-bottom: 8px;
        }

        .login-header h3 {
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
            font-size: 1.6rem;
        }

        .login-header p {
            color: #6c757d;
            font-size: 0.95rem;
            margin: 4px 0 0;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-weight: 600;
            color: #1a1a2e;
            font-size: 0.9rem;
            margin-bottom: 6px;
            display: block;
        }

        .form-group .input-group {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            overflow: hidden;
            transition: 0.2s;
            background: #f8f9fa;
        }

            .form-group .input-group:focus-within {
                border-color: #1a1a2e;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(26, 26, 46, 0.06);
            }

        .form-group .input-group-text {
            background: transparent;
            border: none;
            color: #6c757d;
            padding: 0 0 0 14px;
        }

        .form-group .form-control {
            border: none;
            background: transparent;
            padding: 12px 14px;
            font-size: 0.95rem;
            color: #1a1a2e;
        }

            .form-group .form-control:focus {
                box-shadow: none;
                background: transparent;
            }

            .form-group .form-control::placeholder {
                color: #adb5bd;
            }

        .form-group .text-danger {
            font-size: 0.85rem;
            margin-top: 4px;
            display: block;
        }

    .btn-login {
        background: #1a1a2e;
        color: white;
        border: none;
        padding: 14px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        transition: 0.2s;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 4px;
    }

        .btn-login:hover {
            background: #2d2d44;
            transform: translateY(-2px);
        }

    .login-footer {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
    }

        .login-footer p {
            color: #6c757d;
            font-size: 0.95rem;
            margin: 0;
        }

        .login-footer a {
            color: #1a1a2e;
            font-weight: 600;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }

    .validation-summary {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
        margin-bottom: 20px;
        border: 1px solid #f5c6cb;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .back-link {
        display: inline-block;
        margin-top: 16px;
        color: #6c757d;
        text-decoration: none;
        font-size: 0.9rem;
    }

        .back-link:hover {
            color: #1a1a2e;
        }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 16px 0;
    }

        .remember-me input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #1a1a2e;
        }

        .remember-me label {
            color: #6c757d;
            font-size: 0.9rem;
            margin: 0;
        }

    @@media (max-width: 576px) {
        .login-card {
            padding: 28px 20px;
        }

        .login-header h3 {
            font-size: 1.3rem;
        }

        .btn-login {
            padding: 12px;
            font-size: 0.95rem;
        }
    }
</style>

<div class="login-page">
    <div class="container">

        <div class="login-card">

            <div class="login-header">
                <span class="icon"></span>  
                <h3>Welcome Back</h3>
                <p>Sign in to your account</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <div asp-validation-summary="All" class="text-danger"></div>
           
            <form asp-action="Login" method="post">

                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" name="email" placeholder="you@example.com" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control" name="password" placeholder="Enter your password" required />
                    </div>
                </div>

                <div class="remember-me">
                    <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                    <label for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>

            </form>

            <div class="login-footer">
                <p>
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Signup">Create one now</a>
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="back-link">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}