@{
    ViewData["Title"] = "Mobile Tracker";
}

<style>
  
    .hero {
        padding: 80px 0 60px;
        background: #f8f9fa;
    }

        .hero h1 {
            font-size: 3.2rem;
            font-weight: 700;
            color: #1a1a2e;
            line-height: 1.2;
        }

            .hero h1 span {
                color: #4a6cf7;
            }

        .hero p {
            font-size: 1.1rem;
            color: #6c757d;
            max-width: 480px;
            line-height: 1.8;
            margin-top: 16px;
        }

        .hero .btn-primary {
            background: #1a1a2e;
            border: none;
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 500;
            transition: 0.2s;
        }

            .hero .btn-primary:hover {
                background: #2d2d44;
                transform: translateY(-2px);
            }

        .hero .btn-outline {
            border: 1px solid #1a1a2e;
            color: #1a1a2e;
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 500;
            transition: 0.2s;
        }

            .hero .btn-outline:hover {
                background: #1a1a2e;
                color: white;
            }

    .hero-image {
        text-align: center;
    }

        .hero-image .phone-box {
            background: #ffffff;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.06);
            display: inline-block;
            border: 1px solid #e9ecef;
        }

            .hero-image .phone-box .icon {
                font-size: 72px;
                display: block;
                margin-bottom: 8px;
            }

            .hero-image .phone-box .label {
                font-weight: 600;
                color: #1a1a2e;
            }

            .hero-image .phone-box .sub {
                color: #6c757d;
                font-size: 0.9rem;
            }

  
    .features {
        padding: 70px 0;
        background: #ffffff;
    }

        .features .section-label {
            color: #4a6cf7;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .features h2 {
            font-size: 2.2rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-top: 6px;
        }

        .features .sub-text {
            color: #6c757d;
            max-width: 500px;
            margin: 8px auto 0;
        }

    .feature-item {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 32px 24px;
        text-align: center;
        transition: 0.3s;
        height: 100%;
        border: 1px solid transparent;
    }

        .feature-item:hover {
            background: #ffffff;
            border-color: #e9ecef;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            transform: translateY(-4px);
        }

        .feature-item .icon {
            font-size: 32px;
            margin-bottom: 16px;
            display: block;
        }

        .feature-item h5 {
            font-weight: 600;
            color: #1a1a2e;
        }

        .feature-item p {
            color: #6c757d;
            font-size: 0.95rem;
            margin: 0;
            line-height: 1.6;
        }

    .cta {
        padding: 60px 0;
        background: #f8f9fa;
    }

    .cta-box {
        background: #1a1a2e;
        border-radius: 20px;
        padding: 50px 40px;
        text-align: center;
    }

        .cta-box h3 {
            color: white;
            font-weight: 700;
            font-size: 2rem;
        }

        .cta-box p {
            color: rgba(255,255,255,0.7);
            max-width: 450px;
            margin: 8px auto 24px;
        }

        .cta-box .btn-light {
            background: white;
            color: #1a1a2e;
            padding: 12px 36px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: 0.2s;
        }

            .cta-box .btn-light:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            }

 
    @@media (max-width: 992px) {
        .hero h1 {
            font-size: 2.5rem;
        }

        .features h2 {
            font-size: 1.8rem;
        }

        .cta-box h3 {
            font-size: 1.6rem;
        }
    }

    @@media (max-width: 576px) {
        .hero {
            padding: 40px 0;
        }

            .hero h1 {
                font-size: 2rem;
            }

            .hero .btn {
                width: 100%;
            }

        .hero-buttons {
            flex-direction: column;
            gap: 10px;
        }

            .hero-buttons .btn {
                width: 100%;
                text-align: center;
            }

        .cta-box {
            padding: 32px 20px;
        }

        .feature-item {
            padding: 24px 16px;
        }
    }
</style>

<section class="hero">
    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <h1>
                    Mobile Tracker<br />
                    <span>We're here to help.</span>
                </h1>
                <p>
                    Report your lost device, track your case, and stay informed
                    — all from one simple dashboard.
                </p>
                <div class="d-flex gap-3 flex-wrap hero-buttons">
                    <a asp-controller="Account" asp-action="Signup" class="btn btn-primary">
                        Get Started
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline">
                        Login
                    </a>
                </div>
                <div class="mt-4" style="color:#6c757d; font-size:0.9rem;">
                    <span class="me-3">✓ Free to use</span>
                    <span class="me-3">✓ Case tracking</span>
                    <span>✓ Secure</span>
                </div>
            </div>

           

        </div>

    </div>
</section>

<section class="features">
    <div class="container">

        <div class="text-center mb-5">
            <div class="section-label">How It Works</div>
            <h2>Simple. Fast. Reliable.</h2>
            <p class="sub-text">Everything you need to manage your lost phone case.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-item">
                    <span class="icon"></span>
                    <h5>Report Easily</h5>
                    <p>Submit your phone details, IMEI, and location in minutes.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-item">
                    <span class="icon"></span>
                    <h5>Track Your Case</h5>
                    <p>Get a unique Case ID and monitor your report status.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-item">
                    <span class="icon"></span>
                    <h5>Stay Organized</h5>
                    <p>View all your reports in one place through your dashboard.</p>
                </div>
            </div>

        </div>

    </div>
</section>

